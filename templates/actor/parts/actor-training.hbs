<section class="tab {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
  <div class="training-grid">

    <div class="training-col">
      <div class="button-container">
        <button type="button" title="Retrain" data-action="reTrain" class="set-button">Retrain</button>
      </div>
    </div>

    <div class="training-col">
      <fieldset class="vitamins-attributes">
        <legend>Vitamins</legend>
        <div class="vitamin-row">
          <span class="vitamin-row-label {{#if hpMaxVitaminActive}}overridden{{/if}}">HP</span>
          <input type="checkbox" name="system.vitamins.hp" {{#if hpMaxVitaminActive}}checked{{/if}} {{#unless editable}}disabled{{/unless}} />
        </div>
        <div class="vitamin-row">
          <span class="vitamin-row-label {{#if willMaxVitaminActive}}overridden{{/if}}">Will</span>
          <input type="checkbox" name="system.vitamins.willpower" {{#if willMaxVitaminActive}}checked{{/if}} {{#unless editable}}disabled{{/unless}} />
        </div>
        {{#each system.attributes as |attribute key|}}
        <div class="vitamin-row">
          <span class="vitamin-row-label">{{attribute.label}}</span>
          <select name="system.vitamins.{{key}}" {{#unless ../editable}}disabled{{/unless}}>
            {{selectOptions ../vitaminStateChoices selected=(lookup ../system.vitamins key)}}
          </select>
        </div>
        {{/each}}
      </fieldset>
    </div>

    <div class="training-col">
      <fieldset>
        <legend>Training Points</legend>
        <input type="text" name="system.trainingPoints" value="{{system.trainingPoints}}" data-dtype="Number">
      </fieldset>
      <fieldset class="tp-actions">
        <legend>TP</legend>
        {{#if rankUp}}
        <button type="button" class="tp-action-row {{#if rankUp.ready}}ready{{/if}}" data-action="increaseRank"
          title="Advance to {{rankUp.nextRankLabel}}" {{#unless rankUp.ready}}disabled{{/unless}}>
          <span class="tp-action-label">Rank Up</span>
          <span class="tp-action-progress">{{system.trainingPoints}}/{{rankUp.cost}}</span>
          <img class="tp-action-icon" src="{{rankUp.nextRankIcon}}" />
        </button>
        {{/if}}
        {{#if retrainWithCost}}
        <button type="button" class="tp-action-row {{#if retrainWithCost.ready}}ready{{/if}}" data-action="retrainWithCost"
          title="Retrain" {{#unless retrainWithCost.ready}}disabled{{/unless}}>
          <span class="tp-action-label">Retrain</span>
          <span class="tp-action-progress">{{system.trainingPoints}}/{{retrainWithCost.cost}}</span>
          <i class="fas fa-book-open tp-action-icon"></i>
        </button>
        {{/if}}
      </fieldset>
    </div>

  </div>
</section>
