{"_id":"3GLBcNFktbyDudDI","_stats":{"compendiumSource":null,"coreVersion":"13.348","createdTime":1785195999682,"duplicateSource":null,"exportSource":null,"lastModifiedBy":"TASK47Import0000","modifiedTime":1785195999682,"systemId":"pokerole","systemVersion":"0.8.0"},"effects":[],"flags":{},"folder":null,"img":"systems/pokerole/images/types/fighting.svg","name":"Victory Dance (Physical Damage Pool +1)","ownership":{"default":0},"sort":170000,"system":{"description":"<p>Add 1 Die to the User's Damage Pool for all Non-Ranged Physical Attacks.</p><p><strong>GM note:</strong> the rules system has no ranged/non-ranged distinction, so this also applies to the user's ranged physical moves - slightly broader than the move's text. The accompanying Strength/Defense boost is a separate StatChanges effect, not part of this item.</p>","source":"Move: Victory Dance","enabled":false,"visible":true,"rules":[{"kind":"damagePool","scope":"category","scopeValue":"physical","dice":1}]},"type":"effect"}
