{"_id":"DJcBwpF0E7dq1PmU","_stats":{"compendiumSource":null,"coreVersion":"13.348","createdTime":1764988339048,"duplicateSource":"Macro.Z5z5kHno1LTnrHYx","exportSource":null,"lastModifiedBy":"EyCKp1ZSX9rk44u9","modifiedTime":1764996291230,"systemId":"pokerole","systemVersion":"0.5.0"},"author":"EyCKp1ZSX9rk44u9","command":"// Reworking: resets the selected Pokemon's base stats, typing, Rank, Skills, and full\n// moveset/ability list to match its current species compendium entry - use this after a\n// data update to bring an existing actor up to date. Select the Pokemon's token, run this\n// macro, and confirm the prompt. Destructive: wipes learned-move progress, active ability\n// selection, and Rank/Skill points; unspent Training Points are left alone to re-spend.\nconst controlled = canvas.tokens.controlled;\nif (controlled.length !== 1) {\n  ui.notifications.warn(\"Select exactly one token before running this macro.\");\n  return;\n}\nconst actorData = controlled[0].actor;\n\nconst spec = actorData.system.species;\nconst number = actorData.system.pokedexId;\nconst compendium = game.packs.get(\"pokerole.pokemon\");\nconst indexEntry = compendium.index.find(t => t.name === spec);\n\nif (!indexEntry) {\n  ui.notifications.warn(\"No information was found on POKEROLE Compendium\");\n  return;\n}\n\nconst resetData = await compendium.getDocument(indexEntry._id);\n\nif (number !== resetData.system.pokedexId) {\n  ui.notifications.warn(\"No information was found on POKEROLE Compendium\");\n  return;\n}\n\nconst confirmed = await foundry.applications.api.DialogV2.confirm({\n  window: { title: \"Reworking\" },\n  content: `<p>This will reset <strong>${actorData.name}</strong>'s base stats, typing, and species data to match ${spec}'s current compendium entry, and reset Rank to none, Skills to 0, and the entire moveset/ability list back to the compendium's default. Any learned moves, active ability selection, skill points, and rank progress will be lost. This cannot be undone.</p><p>Continue?</p>`,\n  rejectClose: false\n});\nif (!confirmed) return;\n\nconst SYNCED_KEYS = [\n  \"attributes\", \"social\", \"skills\", \"baseHp\", \"hp\", \"will\",\n  \"type1\", \"type2\", \"type3\", \"hasThirdType\",\n  \"evolutionStage\", \"recommendedRank\", \"pokedexCategory\", \"pokedexDescription\",\n  \"height\", \"weight\", \"evolutions\", \"source\"\n];\nconst updateData = { \"system.rank\": \"none\", \"system.activeAbility\": \"\" };\nfor (const key of SYNCED_KEYS) {\n  updateData[`system.${key}`] = resetData.system[key];\n}\nawait actorData.update(updateData);\n\nconst oldIds = actorData.items.filter(i => i.type === \"move\" || i.type === \"ability\").map(i => i.id);\nif (oldIds.length) {\n  await actorData.deleteEmbeddedDocuments(\"Item\", oldIds);\n}\nawait actorData.createEmbeddedDocuments(\"Item\", resetData.items.filter(i => i.type === \"move\" || i.type === \"ability\"));\n\nui.notifications.info(actorData.name + \" is restarted\");","flags":{"macro-wheel":{"activeCondition":""}},"folder":"M7pZGOU8X5ny5Fy8","img":"systems/pokerole/images/icons/Ranks/5.png","name":"Reworking","ownership":{"default":0,"EyCKp1ZSX9rk44u9":3},"scope":"global","sort":175000,"type":"script"}
{"_id":"lGJ6PxWi5xLNinRX","_stats":{"compendiumSource":"Macro.lGJ6PxWi5xLNinRX","coreVersion":"13.348","createdTime":1764999202057,"duplicateSource":"Macro.GLPbYdL7VDNrZe0p","exportSource":null,"lastModifiedBy":"EyCKp1ZSX9rk44u9","modifiedTime":1764999240006,"systemId":"pokerole","systemVersion":"0.5.0"},"author":"EyCKp1ZSX9rk44u9","command":"let target = game.user.targets.map(({ actor }) => actor); \n\nlet messageContent = ``;\n\nlet weakfolderimg = `<img width=\"30px\" height=\"30px\" style=\"border: 0px solid #555\" src=\"Pokerole%20Assets/Resources/Pokeweak/`;\nlet typefolderimg = `<img width=\"20px\" height=\"20px\" style=\"border: 0px solid #555\" src=\"systems/pokerole/images/types/`;\nlet pstyle = `style=\" display: flex; align-items: center; justify-content: flex-start; font-size: 20px; gap: 2px;\"`;\n\nlet matchs = ``;\n\nfor (const pokemon of target) {\n\n\tmessageContent = `<h2>#${pokemon.system.pokedexId} - ${pokemon.system.species}</h2><p ${pstyle}>`;\n\t\n\tif (pokemon.system.pokedexId != null && pokemon.system.ishuman != true){\n\n\tmatchs = game.pokerole.APIdb.pokemonMatchup(pokemon);\n\n\tmessageContent += `${weakfolderimg}X4.svg\">: `\n\tfor (const type of matchs.doubleWeak) {messageContent += `${typefolderimg}` + `${type}.svg\">`};\n\n\tmessageContent += `</p><p ${pstyle} >${weakfolderimg}X2.svg\">: `\n\tfor (const type of matchs.weak) {messageContent += `${typefolderimg}` + `${type}.svg\">`};\n\n\tmessageContent += `</p><p ${pstyle} >${weakfolderimg}1-2.svg\">: `\n\tfor (const type of matchs.resist) {messageContent += `${typefolderimg}` + `${type}.svg\">`};\n\n\tmessageContent += `</p><p ${pstyle} >${weakfolderimg}1-4.svg\">: `\n\tfor (const type of matchs.doubleResist) {messageContent += `${typefolderimg}` + `${type}.svg\">`};\n\n\tmessageContent += `</p><p ${pstyle} >${weakfolderimg}X0.svg\">: `\n\tfor (const type of matchs.immune) {messageContent += `${typefolderimg}` + `${type}.svg\">`};\n\n\t};\n\n\tmessageContent += `</p>`\n\n\tChatMessage.create({\n            \tspeaker: ChatMessage.getSpeaker(),\n            \tcontent: messageContent\n\t});\t\n};","flags":{"macro-wheel":{"activeCondition":""}},"folder":null,"img":"systems/pokerole/images/icons/matchups/X2.svg","name":"Pokematch","ownership":{"default":2,"EyCKp1ZSX9rk44u9":3},"scope":"global","sort":-100000,"type":"script"}
